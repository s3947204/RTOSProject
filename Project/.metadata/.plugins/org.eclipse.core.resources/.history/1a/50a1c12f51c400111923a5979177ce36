#include <stdio.h>
#include <stdbool.h>
#include <pthread.h>
#include <time.h>

enum states { State0, State1, State2 };

static enum states CurState = State0;
static bool Done = false;
static pthread_mutex_t stateMutex = PTHREAD_MUTEX_INITIALIZER;

char input;

static void pause_ms(long ms)
{
    struct timespec delay = {
        .tv_sec = ms / 1000,
        .tv_nsec = (ms % 1000) * 1000000L
    };
    nanosleep(&delay, NULL);
}

/* Replace with your actual sensor read.
   Return true when a train is detected. */
static bool test1(void)
{
	while(scanf("%c", &input) == 1){

	}
    return true;
}

static void *railSensor(void *data)
{
    (void)data;

    while (!Done) {
        bool trainPresent = test1();

        pthread_mutex_lock(&stateMutex);
        CurState = trainPresent ? State1 : State0;
        pthread_mutex_unlock(&stateMutex);

        pause_ms(10);   // Poll interval; choose for your sensor/system.
    }

    return NULL;
}

int main(void)
{
    pthread_t th1;

    if (pthread_create(&th1, NULL, railSensor, NULL) != 0) {
        perror("pthread_create");
        return 1;
    }

    while (!Done) {
        enum states state;

        pthread_mutex_lock(&stateMutex);
        state = CurState;
        pthread_mutex_unlock(&stateMutex);

        switch (state) {
        case State0:
            printf("Waiting for train\n");
            break;
        case State1:
            printf("Train detected\n");
            break;
        case State2:
            printf("Crossing error\n");
            break;
        }

        fflush(stdout);
        pause_ms(500);
    }

    pthread_join(th1, NULL);
    return 0;
}
