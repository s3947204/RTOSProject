#include <stdio.h>
#include <stdbool.h>
#include <pthread.h>
#include <time.h>

enum states { State0, State1, State2 };

static enum states CurState = State0;
static bool Done = false;
static pthread_mutex_t stateMutex = PTHREAD_MUTEX_INITIALIZER;

static void *railSensor(void *data)
{
    (void)data;
    int key;

    printf("Enter 1 for train detected, 0 for clear, q to quit:\n");
    fflush(stdout);

    while ((key = getchar()) != EOF) {
        pthread_mutex_lock(&stateMutex);

        if (key == '1') {
            CurState = State1;
        } else if (key == '0') {
            CurState = State0;
        } else if (key == 'q' || key == 'Q') {
            Done = true;
            pthread_mutex_unlock(&stateMutex);
            break;
        }

        pthread_mutex_unlock(&stateMutex);
    }

    return NULL;
}

int main(void)
{
    pthread_t th1;

    if (pthread_create(&th1, NULL, railSensor, NULL) != 0) {
        perror("pthread_create");
        return 1;
    }

    enum states lastState = State2; /* Force an initial status message */

    while (1) {
        enum states state;
        bool done;

        pthread_mutex_lock(&stateMutex);
        state = CurState;
        done = Done;
        pthread_mutex_unlock(&stateMutex);

        if (done) {
            break;
        }

        if (state != lastState) {
            if (state == State0) {
                printf("Waiting for train\n");
            } else if (state == State1) {
                printf("Train detected\n");
            }
            fflush(stdout);
            lastState = state;
        }
    }

    pthread_join(th1, NULL);
    return 0;
}
