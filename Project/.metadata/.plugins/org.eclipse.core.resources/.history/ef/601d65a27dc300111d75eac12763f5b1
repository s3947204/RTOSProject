#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

enum states {
	State0,
	State1,
	State2,
	State3,
	State4,
	State5,
	State6
};
enum states CurrentState;

void SingleStep_TrafficLight_SM();

int main(int argc, char *argv[]) {

	printf("Fixed Sequence Traffic Lights State Machine Example\n");

	int Runtimes=30, counter = 0;
	enum states CurrentState; // Declaring the enum within the main
							  // means we will need to pass it by address
	while (counter < Runtimes) {
		SingleStep_TrafficLight_SM( &CurrentState ); // pass address
		counter++;
	}
}

void SingleStep_TrafficLight_SM(void) {
    switch(CurrentState){
    	case State0:
			printf("State 0\n");
			sleep(1);
			CurrentState = State1;
			break;

    	case State1:
    		printf("State 1\n");
    		sleep(1);
    		CurrentState = State2;
    		break;

    	case State2:
    	    printf("State 2\n");
    	    sleep(2);
    	    CurrentState = State3;
    	    break;
    }
}
