#include <stdio.h>
#include <stdbool.h>
#include <pthread.h>

enum states {
	State0,
	State1,
	State2
};
enum states CurState = State0;

bool Done = false;
bool gatesLowered;
bool redLight;
bool crossingAlarm;
bool trainSignalRed;
bool printed = false;

pthread_mutex_t stateMutex = PTHREAD_MUTEX_INITIALIZER;

void crossingOpen();
void crossingClosed();

void *railSensor (void *data){
	//(void)data;
	int key;

	printf("Enter t to simulate train detection, n to clear sensor");
	fflush(stdout);

	while ((key = getchar()) != EOF){
		pthread_mutex_lock(&stateMutex);

		if (key == 't') {
			CurState = State1;
		} else if (key == 'n'){
			CurState = State0;
		}
		pthread_mutex_unlock(&stateMutex);
	}
	return NULL;
}

int main(void){

	pthread_t th1;

	if (pthread_create (&th1, NULL, railSensor, NULL) != 0) {
		perror("pthread_create");
		return 1;
	}

	enum states lastState = State2;

	while(1) {
		enum states state;
		bool done;
	}

	pthread_mutex_lock(&stateMutex);
	state = CurState;
	done = Done;
	pthread_mutex_unlock(&stateMutex);

	if (done) {
		break;
	}

	if (state != lastState){
		if (state == State0){
			printf("Waiting for train\n");
		} else if (state == State1){
			printf("Train detected\n");
		}
		fflush(stdout);
		lastState = state;
	}

	pthread_join (th1, NULL);
	return 0;
}

void crossingOpen(void) {
	gatesLowered = false;
	redLight = false;
	crossingAlarm = false;
	trainSignalRed = true;
}

void crossingClosed(void) {
	gatesLowered = true;
	redLight = true;
	crossingAlarm = true;
	trainSignalRed = false;
}
